<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DMCBK.OfficialPlugins.AutoRelog</AssemblyName>
    <RootNamespace>DMCBK.OfficialPlugins.AutoRelog</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>2.0.1</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AutoRelog.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DMCBK.PluginSdk" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
