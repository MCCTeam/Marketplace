<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DMCBK.OfficialPlugins.LlmTest</AssemblyName>
    <RootNamespace>DMCBK.OfficialPlugins.LlmTest</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.2.2</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LlmTest.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../LlmCore/LlmCore.csproj">
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="DMCBK.PluginSdk" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
