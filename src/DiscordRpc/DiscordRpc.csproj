<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DMCBK.OfficialPlugins.DiscordRpc</AssemblyName>
    <RootNamespace>DMCBK.OfficialPlugins.DiscordRpc</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>2.0.2</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DiscordRpc.cs" />
    <Compile Include="DiscordRpcPipeClient.cs" />
    <Compile Include="PresenceFormatter.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DMCBK.PluginSdk" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
